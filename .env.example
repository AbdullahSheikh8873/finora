APP_NAME=Finora
APP_ENV=production
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string-before-deploying
ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

DATABASE_URL=postgresql+psycopg://finora:change-me@postgres:5432/finora

POSTGRES_DB=finora
POSTGRES_USER=finora
POSTGRES_PASSWORD=change-me

DEFAULT_CURRENCY=PKR
CORS_ORIGINS=http://localhost,http://localhost:8000
COOKIE_SECURE=false
